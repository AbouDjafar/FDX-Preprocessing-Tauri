{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FDX Atelier Tauri",
  "version": "2.0.0",
  "identifier": "com.fdx.atelier.tauri",
  "build": {
    "beforeBuildCommand": "npm --prefix ../web run build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [{"label":"main","title":"FDX Atelier","width":1280,"height":850,"minWidth":760,"minHeight":600,"backgroundColor":"#f5f2e9","dragDropEnabled":true}],
    "security": {"csp":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"}
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Preparation locale de classeurs metier",
    "category": "Productivity",
    "icon": ["icons/32x32.png","icons/128x128.png","icons/icon.ico"],
    "windows": {"webviewInstallMode":{"type":"embedBootstrapper"},"nsis":{"languages":["French"],"displayLanguageSelector":false,"installMode":"currentUser"}}
  }
}
